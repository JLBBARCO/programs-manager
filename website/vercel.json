{
  "version": 2,
  "installCommand": null,
  "buildCommand": "echo Static site: no build required",
  "outputDirectory": "client",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [{ "path": "/api/cron/releases", "schedule": "0 6 * * *" }],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}
