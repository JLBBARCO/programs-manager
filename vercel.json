{
  "version": 2,
  "installCommand": null,
  "buildCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [{ "path": "/api/cron/releases", "schedule": "0 6 * * *" }],
  "routes": [
    { "src": "/api/(.*)", "dest": "/website/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/website/client/$1" }
  ]
}
